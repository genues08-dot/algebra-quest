rules_version = '2';

// Algebra Quest's database rules. Paste this file into the Firebase console:
// Firestore Database, then Rules, then Publish.
//
// Both are named by the username in lowercase, so a player who signs up again with the same
// username (after the owner deletes a login with a forgotten password) gets them back.
// - saves/{name}: a player's progress. Only that player can read or change it.
// - players/{name}: a player's leaderboard row. Every logged-in player can read it; only its
//   owner can change it.
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // The app logs in username "axl_fan" as "axl_fan@algebra-quest1.firebaseapp.com". The whole
    // address is checked, so a login made some other way (such as "axl_fan@gmail.com") owns nothing.
    function isOwner(name) {
      return request.auth != null && request.auth.token.email == name + '@algebra-quest1.firebaseapp.com';
    }

    function validSave(data) {
      return data.keys().hasOnly(['save', 'savedAt']) &&
        data.save is string && data.save.size() < 900000 &&
        data.savedAt is string && data.savedAt.size() < 40;
    }

    function validXp(value) {
      return value is int && value >= 0 && value <= 10000000;
    }

    function validRow(data, name) {
      return data.keys().hasOnly(['name', 'nameLower', 'weekXp', 'week', 'totalXp', 'color', 'hat', 'updated']) &&
        data.nameLower == name &&
        data.name is string && data.name.matches('[A-Za-z0-9_]{3,15}') && data.name.lower() == data.nameLower &&
        validXp(data.weekXp) && validXp(data.totalXp) && data.weekXp <= data.totalXp &&
        data.week is string && data.week.size() == 10 &&
        data.color in ['pink', 'purple', 'blue'] &&
        (data.hat == null || data.hat in ['party', 'beanie', 'bow', 'grad', 'wizard', 'crown']) &&
        data.updated == request.time;
    }

    match /saves/{name} {
      allow read, delete: if isOwner(name);
      allow create, update: if isOwner(name) && validSave(request.resource.data);
    }

    match /players/{name} {
      allow read: if request.auth != null;
      allow delete: if isOwner(name);
      allow create, update: if isOwner(name) && validRow(request.resource.data, name);
    }
  }
}
