rules_version = '2';

// Algebra Quest's database rules. Paste this file into the Firebase console:
// Firestore Database, then Rules, then Publish.
//
// Both kinds of document are named by the username in lowercase, so a player who signs up again
// with the same username (after the owner deletes a login with a forgotten password) gets them back.
// - saves/{name}: a player's progress. Only that player can read or change it.
// - players/{name}: a player's leaderboard row. Every logged-in player can read it; only its
//   owner can change it.
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // The app logs in username "axl_fan" as "axl_fan@algebra-quest1.firebaseapp.com" (the domain
    // is AQ_LOGIN_DOMAIN in js/firebase-config.js). The whole address is checked, so a login made
    // some other way (such as "axl_fan@gmail.com") owns nothing.
    function isOwner(name) {
      return request.auth != null && name.matches('[a-z0-9_]{3,15}') &&
        request.auth.token.email == name + '@algebra-quest1.firebaseapp.com';
    }

    // rev names this save; base names the save it grew from (null for the first one).
    function validSave(data) {
      return data.keys().hasOnly(['save', 'rev', 'base']) &&
        data.save is string && data.save.size() < 1000000 &&
        data.rev is string && data.rev.size() <= 40 &&
        (data.base == null || (data.base is string && data.base.size() <= 40));
    }

    function validXp(value) {
      return value is int && value >= 0 && value <= 10000000;
    }

    function validRow(data, name) {
      return data.keys().hasOnly(['name', 'nameLower', 'weekXp', 'week', 'totalXp', 'color', 'hat', 'updated']) &&
        data.nameLower == name &&
        data.name is string && data.name.matches('[A-Za-z0-9_]{3,15}') && data.name.lower() == data.nameLower &&
        validXp(data.weekXp) && validXp(data.totalXp) && data.weekXp <= data.totalXp &&
        data.week is string && data.week.size() == 10 &&
        // The pet's look: every id in AQ.mascot.LOOK_IDS (js/mascot.js). tests/online.test.js checks it.
        data.color in [
          'pink', 'purple', 'blue', 'duck-pekin', 'duck-mallard', 'duck-black',
          'horse-bay', 'horse-palomino', 'horse-gray', 'chicken-buff', 'chicken-white', 'chicken-black',
          'giraffe-golden', 'giraffe-chestnut', 'giraffe-cream', 'bear-polar', 'bear-brown', 'bear-black',
          'fox-red', 'fox-silver', 'fox-arctic', 'dog-golden', 'dog-chocolate', 'dog-black',
          'cat-orange', 'cat-gray', 'cat-tuxedo', 'cow-black-white', 'cow-brown-white', 'cow-jersey',
          'goat-white', 'goat-brown', 'goat-black-white', 'hamster-golden', 'hamster-cream', 'hamster-black-white',
          'frog-green', 'frog-blue', 'frog-golden', 'penguin-emperor', 'penguin-rockhopper', 'penguin-little-blue'
        ] &&
        (data.hat == null || data.hat in ['party', 'beanie', 'bow', 'grad', 'wizard', 'crown']) &&
        data.updated == request.time;
    }

    match /saves/{name} {
      allow read, delete: if isOwner(name);
      allow create: if isOwner(name) && validSave(request.resource.data);
      // Only a save that grew from the one now in the cloud. A device holding older progress
      // (opened offline, or left open while another device played) can't write over newer progress.
      allow update: if isOwner(name) && validSave(request.resource.data) &&
        request.resource.data.base == resource.data.get('rev', null);
    }

    match /players/{name} {
      allow read: if request.auth != null;
      allow delete: if isOwner(name);
      allow create: if isOwner(name) && validRow(request.resource.data, name);
      // At most one change every 5 seconds.
      allow update: if isOwner(name) && validRow(request.resource.data, name) &&
        request.time > resource.data.updated + duration.value(5, 's');
    }
  }
}
